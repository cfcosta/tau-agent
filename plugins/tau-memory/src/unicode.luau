-- Those it maps to more than one.
M.EXPAND = {
	[304] = "\u{69}\u{307}",
}

-- What else `(?i)` matches for an ASCII letter, by code point: the
-- letter, lowercase.
M.FOLD = {
	[8490] = "k",
	[383] = "s",
}

-- Whether `code` is in `ranges`.
function M.has(ranges, code)
	local lo, hi = 1, #ranges // 2
	while lo <= hi do
		local mid = (lo + hi) // 2
		if code < ranges[2 * mid - 1] then
			hi = mid - 1
		elseif code > ranges[2 * mid] then
			lo = mid + 1
		else
			return true
		end
	end
	return false
end

-- What `to_lowercase` maps `code` to, as text.
function M.lower(code)
	if M.EXPAND[code] then
		return M.EXPAND[code]
	end
	local lower = M.LOWER
	local lo, hi = 1, #lower // 4
	while lo <= hi do
		local mid = (lo + hi) // 2
		local at = 4 * mid - 3
		if code < lower[at] then
			hi = mid - 1
		elseif code > lower[at + 1] then
			lo = mid + 1
		else
			if (code - lower[at]) % lower[at + 2] == 0 then
				return utf8.char(code + lower[at + 3])
			end
			break
		end
	end
	return utf8.char(code)
end

return M
