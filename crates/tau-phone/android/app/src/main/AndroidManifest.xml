<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The camera app, to photograph a pairing code. No CAMERA
         permission: the camera app takes the photo. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!-- wgpu draws with Vulkan, or GL ES 3.0 where there is none. -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:required="false"
        android:version="0x00401000"
    />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:label="tau"
        android:theme="@android:style/Theme.Material.NoActionBar"
    >
        <!-- gpui-pre-mobile's NativeActivity, with an input connection
             for the on-screen keyboard. -->
        <activity
            android:name="dev.gpui.mobile.GpuiInputActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
        >
            <!-- libtau_phone.so -->
            <meta-data android:name="android.app.lib_name" android:value="tau_phone" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Opens the camera app for one photo of a pairing code. -->
        <activity
            android:name="dev.cfcosta.tau.TauCaptureActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
        />
        <!-- Where the camera app writes that photo. -->
        <provider
            android:name="dev.cfcosta.tau.TauPhotos"
            android:authorities="dev.cfcosta.tau.photos"
            android:exported="false"
            android:grantUriPermissions="true"
        />
    </application>

</manifest>
